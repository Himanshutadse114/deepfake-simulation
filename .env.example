NODE_ENV=development
PORT=10000
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-secret

# One Replicate account powers the active production stack.
REPLICATE_API_TOKEN=

# Voice cloning: Qwen3-TTS per-session reference-audio cloning.
VOICE_PROVIDER=qwen
QWEN_MODEL=qwen/qwen3-tts
QWEN_LANGUAGE=auto

# Social-profile image generation: FLUX.2 Pro, generated after the first learning checkpoint.
FLUX_ENABLED=true
FLUX_MODEL=black-forest-labs/flux-2-pro
FLUX_GRID_IMAGES=4

# Talking-head video generation: Pruna.
VIDEO_PROVIDER_PREFERENCE=pruna
PRUNA_MODEL=prunaai/p-video-avatar
PRUNA_RESOLUTION=720p

# Optional inactive providers kept for testing/fallback only.
CHATTERBOX_MODEL=resemble-ai/chatterbox-multilingual:9cfba4c265e685f840612be835424f8c33bdee685d7466ece7684b0d9d4c0b1c
CHATTERBOX_LANGUAGE=en
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
DID_API_KEY=
DID_ADAPTER_ENABLED=false
HEYGEN_ACCESS_TOKEN=
HEYGEN_API_KEY=
HEYGEN_ADAPTER_ENABLED=false

MAX_IMAGE_SIZE_MB=8
MAX_AUDIO_SIZE_MB=20
MEDIA_RETENTION_MINUTES=30
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MINUTES=60
DEMO_MODE=false
