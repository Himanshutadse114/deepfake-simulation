NODE_ENV=development
PORT=10000
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-secret

# Voice generation: Replicate Chatterbox Multilingual
REPLICATE_API_TOKEN=
CHATTERBOX_MODEL=resemble-ai/chatterbox-multilingual:9cfba4c265e685f840612be835424f8c33bdee685d7466ece7684b0d9d4c0b1c
CHATTERBOX_LANGUAGE=en

# D-ID video test path. Use a freshly rotated Studio credential in API_USERNAME:API_PASSWORD format.
DID_API_KEY=
DID_ADAPTER_ENABLED=true
VIDEO_PROVIDER_PREFERENCE=did

# Optional alternate video providers kept for later comparison.
PRUNA_MODEL=prunaai/p-video-avatar
PRUNA_RESOLUTION=720p
HEYGEN_ACCESS_TOKEN=
HEYGEN_API_KEY=
HEYGEN_ADAPTER_ENABLED=true

MAX_IMAGE_SIZE_MB=8
MAX_AUDIO_SIZE_MB=20
MEDIA_RETENTION_MINUTES=30
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MINUTES=60
DEMO_MODE=false
