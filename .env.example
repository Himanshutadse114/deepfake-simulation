NODE_ENV=development
PORT=10000
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-secret

# Protects /admin script configuration. Set a long private value in production.
ADMIN_KEY=replace-with-a-long-private-admin-key

# Optional boot defaults. The /admin page can replace these at runtime.
WHATSAPP_AUDIO_SCRIPT=This is an AI voice-clone awareness demo. A familiar voice can be faked, so verify unusual requests through a trusted channel before you act.
VIDEO_AUDIO_SCRIPT=This is an AI-generated deepfake awareness demo. A familiar face and voice are not proof of identity, so verify sensitive requests independently.

# Admin-script policy controls.
# These are read by the server at startup; change them in Render and redeploy.
SCRIPT_MIN_CHARS=20
SCRIPT_MAX_CHARS=180
SCRIPT_BLOCK_URLS=true
SCRIPT_REQUIRE_AWARENESS_CONTEXT=false

# Core sensitive-request protection is always enforced for cloned speech.

# One Replicate account powers the active production stack.
REPLICATE_API_TOKEN=

# Voice cloning: Qwen3-TTS per-session reference-audio cloning.
VOICE_PROVIDER=qwen
QWEN_MODEL=qwen/qwen3-tts
QWEN_LANGUAGE=auto
MAX_VIDEO_SECONDS=10

# Four social-profile images are generated with the initial media pipeline.
FLUX_ENABLED=true
FLUX_MODEL=black-forest-labs/flux-2-pro

# Talking-head video generation: Pruna.
VIDEO_PROVIDER_PREFERENCE=pruna
PRUNA_MODEL=prunaai/p-video-avatar
PRUNA_RESOLUTION=720p

# Optional inactive providers kept for testing/fallback only.
CHATTERBOX_MODEL=resemble-ai/chatterbox-multilingual:9cfba4c265e685f840612be835424f8c33bdee685d7466ece7684b0d9d4c0b1c
CHATTERBOX_LANGUAGE=en
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
DID_API_KEY=
DID_ADAPTER_ENABLED=false
HEYGEN_ACCESS_TOKEN=
HEYGEN_API_KEY=
HEYGEN_ADAPTER_ENABLED=false

MAX_IMAGE_SIZE_MB=8
MAX_AUDIO_SIZE_MB=20
MEDIA_RETENTION_MINUTES=30
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MINUTES=60
DEMO_MODE=false
