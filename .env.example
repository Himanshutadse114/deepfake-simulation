NODE_ENV=development
PORT=10000
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-secret

# Google Gemini 2.5 Flash - used for media suitability checks only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs - Instant Voice Clone + TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# D-ID - photo animation / lip sync.
# Paste the D-ID API credential exactly as shown in Studio (username:password).
DID_API_KEY=

MAX_IMAGE_SIZE_MB=8
MAX_AUDIO_SIZE_MB=20
MEDIA_RETENTION_MINUTES=30
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MINUTES=60

# Set true only for UI/backend development without paid provider calls.
DEMO_MODE=false
