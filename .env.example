NODE_ENV=development
PORT=10000
APP_BASE_URL=http://localhost:10000
SESSION_SECRET=replace-with-a-long-random-secret

# Protects /admin script configuration. Set a long private value in production.
ADMIN_KEY=replace-with-a-long-private-admin-key

# ONE-SERVICE PRODUCTION MODE
# Leave REDIS_URL unset. The one Render web service uses a bounded in-process
# queue while R2 stores durable sessions, checkpoints, budget reservations and
# generated media so unfinished jobs can be reconstructed after a restart.
AI_WORKER_CONCURRENCY=4
FFMPEG_CONCURRENCY=2
AI_MAX_QUEUED_JOBS=250

# Conservative admission guard. Each AI simulation reserves this estimate before
# entering the paid queue. Increase/decrease only after measuring real spend.
AI_DAILY_BUDGET_USD=50
ESTIMATED_SIMULATION_COST_USD=0.35

# Main-platform signed launch protection. Token format is:
# base64url({userId,tenantId,campaignId,exp}).base64url(HMAC_SHA256(payload))
LAUNCH_TOKEN_SECRET=
REQUIRE_LAUNCH_TOKEN=false

# Cloudflare R2 / S3-compatible PRIVATE storage. Required for durable one-service
# production. For R2 use region=auto and the account-level R2 S3 API endpoint.
S3_BUCKET=innvikta-deepfake-media
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional boot defaults. The /admin page can replace these at runtime; when R2
# is configured, admin script changes also survive Render restarts.
WHATSAPP_AUDIO_SCRIPT=This is an AI voice-clone awareness demo. A familiar voice can be faked, so verify unusual requests through a trusted channel before you act.
VIDEO_AUDIO_SCRIPT=This is an AI-generated deepfake awareness demo. A familiar face and voice are not proof of identity, so verify sensitive requests independently.

# Admin-script policy controls.
SCRIPT_MIN_CHARS=20
SCRIPT_MAX_CHARS=180
SCRIPT_BLOCK_URLS=true
SCRIPT_REQUIRE_AWARENESS_CONTEXT=false

# One Replicate account powers the active production stack.
REPLICATE_API_TOKEN=

# Voice cloning: Qwen3-TTS per-session reference-audio cloning.
VOICE_PROVIDER=qwen
QWEN_MODEL=qwen/qwen3-tts
QWEN_LANGUAGE=auto

# Before Qwen is called, the uploaded participant voice is locally decoded with
# ffprobe. Samples shorter than 2 s or longer than this limit are rejected free.
MAX_REFERENCE_AUDIO_SECONDS=60

# WhatsApp audio may be up to 12 seconds. Video audio is independently capped by
# MAX_VIDEO_SECONDS so Pruna is never paid to render seconds that are discarded.
MAX_VIDEO_SECONDS=10

# Four social-profile tiles come from ONE 2 MP FLUX.2 Pro 2x2 grid prediction.
# The FLUX-only identity reference is resized to <=1024px first.
FLUX_ENABLED=true
FLUX_MODEL=black-forest-labs/flux-2-pro

# Talking-head video generation: Pruna. Keep fallback disabled unless an admin
# intentionally accepts the possibility of a second paid provider attempt.
VIDEO_PROVIDER_PREFERENCE=pruna
PRUNA_MODEL=prunaai/p-video-avatar
PRUNA_RESOLUTION=720p
ALLOW_PAID_VIDEO_FALLBACK=false

# Optional inactive providers kept for controlled testing only.
CHATTERBOX_MODEL=resemble-ai/chatterbox-multilingual:9cfba4c265e685f840612be835424f8c33bdee685d7466ece7684b0d9d4c0b1c
CHATTERBOX_LANGUAGE=en
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
DID_API_KEY=
DID_ADAPTER_ENABLED=false
HEYGEN_ACCESS_TOKEN=
HEYGEN_API_KEY=
HEYGEN_ADAPTER_ENABLED=false

MAX_IMAGE_SIZE_MB=8
MAX_AUDIO_SIZE_MB=20
MEDIA_RETENTION_MINUTES=30

# Abuse backstop only. Entitlement is per signed user/tenant/campaign, not IP,
# because many corporate learners can share a single public NAT address.
RATE_LIMIT_MAX=250
RATE_LIMIT_WINDOW_MINUTES=15
DEMO_MODE=false
